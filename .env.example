# =============================================================================
# SF Assistant MCP Server — Credentials template
# =============================================================================
# Copy this file to `.env` and fill in the secrets.
# `.env` is gitignored — never commit it.
#
# Example values shown match the **VPMC Sandbox** tenant
# (api8preview.sapsf.com / VPMCSandbox). For other tenants, ask the
# functional lead for the right OIDC client + IAS host.
# =============================================================================

# --- SF Tenant (VPMC Sandbox) ---
SF_API_HOST=https://api8preview.sapsf.com
SF_COMPANY_ID=VPMCSandbox
SF_USER_ID=<your-ias-user>
SF_PASSWORD=<your-ias-password>

# --- IAS / OIDC Configuration (VPMC Sandbox) ---
IAS_HOST=abkakgd3p.accounts.ondemand.com
OIDC_CLIENT_ID=<oidc-client-id>
OIDC_CLIENT_SECRET=<oidc-client-secret>
IAS_DEPENDENCY_NAME=SF_DEPENDENCY

# --- Security (optional) ---
# Extra SF API hosts accepted as `data_center` overrides, comma-separated.
# DC codes and SF_API_HOST are always allowed; everything else is rejected.
SF_ALLOWED_HOSTS=
# true (default) blocks HIGHLY CONFIDENTIAL queries; false only warns.
PII_STRICT_MODE=true

# --- Web frontend (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
FRONTEND_BACKEND_PORT=8001
FRONTEND_CORS_ORIGIN=http://localhost:5173
